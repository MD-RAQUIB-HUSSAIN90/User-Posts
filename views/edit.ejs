<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit content</title>
    <link rel="stylesheet" href="/style.css">
</head>


<body class="new-form-body quora">
    <h1>Edit your post</h1>

    <div class="outer">
        <p>Post Id: <%= post.id%></p>
        <h3 class="h4-username">Post Username: @<%=post.username%></h3>
        <form method="post" action="/posts/<%=post.id%>?_method=PATCH" class="inner-form">
            <textarea name="content"  class="editContent"><%=post.content%></textarea>
            <button class="index-child-btn">Submit</button>
        </form>
    </div>


    <form method="get" action="/posts" id="home-page"><button class="index-child-btn">GO Home</button></form>

</body>

</html>