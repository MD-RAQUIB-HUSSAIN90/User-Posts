<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit content</title>
    <link rel="stylesheet" href="/style.css">
</head>


<body class="new-form-body">
    <h2>Edit your post</h2>

    <div class="outer">
        <p>Post Id: <%= post.id%></p>
        <h4 class="h4-username">Post Username: @<%=post.username%></h4>
        <form method="post" action="/posts/<%=post.id%>?_method=PATCH" class="inner-form">
            <textarea name="content" id="edit"><%=post.content%></textarea>
            <button>Submit</button>
        </form>
    </div>



</body>

</html>