<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create New Post</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body class="new-form-body">

    <div>
        <form method="post" action="/posts" class="outer">
            <div> <label for="username">Username</label>
                <input id="username" type="text" placeholder="enter username" name="username" required
                    pattern="[A-Za-z ]{3,20}"
                    title="Username must be 3-20 characters and contain only English letters and spaces.">
            </div>

            <textarea name="content" id="content" rows="5" cols="15" placeholder="Text Your content" required
                pattern="[\s\S]{5,500}" title="Content must be between 5 and 500 characters."></textarea>
            <button>submit</button>
        </form>
    </div>

    <form method="get" action="/posts"><button>GO Home</button></form>

</body>

</html>