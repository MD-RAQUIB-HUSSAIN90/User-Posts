<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Posts</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body class="indx-ejs new-form-body">

    <h1 class="quora">User Post</h1>

    <% for(post of posts){%>
        <div class="post">
            <h3> username : @<%= post.username%>
            </h3>
            <p class="content">content: <%=post.content%>
            </p>
            <div class="index-btn">
                <form method="get" action="/posts/<%=post.id%>">
                    <button class="index-child-btn"> Preview</button>
                </form>
                <form method="get" action="/posts/<%=post.id%>/edit">
                    <button class="index-child-btn"> Edit</button>
                </form>
                <form method="post" action="/posts/<%=post.id%>?_method=DELETE">
                    <button class="index-child-btn"> Delete Post</button>
                </form>
            </div>

        </div>
        <br>
        <%}%>
            <form method="get" action="/posts/new">
                <button class="index-child-btn">Create New Post</button>
            </form>

            <script src="/script.js"></script>
</body>

</html>